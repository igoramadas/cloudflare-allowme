{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "cloudflare-allowme",
    "main": "src/index.ts",
    "compatibility_date": "2025-10-08",
    "compatibility_flags": ["nodejs_compat"],
    "observability": {
        "enabled": true
    },
    "containers": [
        {
            "class_name": "AllowMeContainer",
            "image": "../Dockerfile",
            "image_build_context": "..",
            "max_instances": 1,
            "instance_type": "lite"
        }
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "ALLOWME_CONTAINER",
                "class_name": "AllowMeContainer"
            }
        ]
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["AllowMeContainer"]
        }
    ],
    "triggers": {
        "crons": ["0 * * * *"]
    },
    "vars": {
        "ALLOWME_CF_ZONE": "",
        "ALLOWME_SERVER_PORT": "8080",
        "ALLOWME_SERVER_TRUSTPROXY": "true",
        "ALLOWME_SERVER_PROMPT": "true",
        "ALLOWME_CF_ACCOUNTID": "",
        "ALLOWME_CF_LISTID": "",
        "ALLOWME_SERVER_USER": "",
        "ALLOWME_SERVER_HOME": "",
        "ALLOWME_IP_MAXAGE": "",
        "ALLOWME_IP_BLOCKINTERVAL": "",
        "ALLOWME_IP_DENYCOUNT": "",
        "ALLOWME_LOG_LEVEL": ""
    },
    "upload_source_maps": true
}

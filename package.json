{
    "name": "cloudflare-allowme",
    "version": "1.6.0",
    "description": "Simplistic Cloudflare firewall manager to allow source IPs on a specific Cloudflare zone.",
    "keywords": [
        "access",
        "cloudflare",
        "firewall",
        "ip"
    ],
    "author": "Igor Ramadas <igor@ramadas.net>",
    "homepage": "https://github.com/igoramadas/cloudflare-allowme",
    "license": "MIT",
    "bin": {
        "allowme": "bin/allowme"
    },
    "files": [
        "bin",
        "lib"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/igoramadas/cloudflare-allowme.git"
    },
    "engines": {
        "bun": ">= 1.3",
        "node": ">= 22.0"
    },
    "scripts": {
        "build": "tsc",
        "prepublishOnly": "tsc --removeComments",
        "start": "bun src/index.ts"
    },
    "dependencies": {
        "anyhow": "^4.0.0",
        "axios": "^1.20.0",
        "express": "^5.3.0",
        "ua-parser-js": "^2.0.10"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/bun": "^1.4.3",
        "@types/ua-parser-js": "^0.7.39",
        "typescript": "^7.0.2"
    },
    "prettier": {
        "trailingComma": "none",
        "tabWidth": 4,
        "semi": false,
        "singleQuote": false,
        "arrowParens": "always",
        "bracketSpacing": false,
        "printWidth": 250
    },
    "reviewAgents": {
        "ready": "@coderabbitai"
    }
}

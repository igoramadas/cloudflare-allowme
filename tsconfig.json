{
    "compilerOptions": {
        "strict": false,
        "rootDir": "src",
        "outDir": "lib",
        "target": "es2025",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "noUnusedParameters": true,
        "noUnusedLocals": true,
        "declaration": true
    }
}
